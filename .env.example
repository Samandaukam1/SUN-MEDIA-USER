# Faqat ommaviy Supabase qiymatlari. service_role / sb_secret_ kalitini BU YERGA YOZMANG.
EXPO_PUBLIC_SUPABASE_URL=
# Legacy anon JWT yoki yangi sb_publishable_ kalitidan bittasi
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# EAS (push notification va build uchun), maxfiy emas
EAS_PROJECT_ID=
EXPO_OWNER=

# Local development: keep unset. EAS preview profile sets APP_VARIANT=preview.
# Preview build/update commands disable local .env loading (EXPO_NO_DOTENV=1).
# Template for the remote preview environment: env/preview.example
